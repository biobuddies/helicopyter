    }
  }
  name = {
    endswith = "example.com"
  }
  proxied = true
  zone_id = "0123456789abcdef0123456789abcdef01"
}

resource "cloudflare_workers_script" "this" {
  account_id = "0123456789abcdef0123456789abcdef00"
  assets = {
    config = {
      not_found_handling = "single-page-application"
      run_worker_first   = ["/api/*"]
    }
    directory = "../../../site"
  }
  compatibility_date = "2026-08-28"
  content            = "export default {\n    async fetch() {\n        return new Response('API placeholder')\n    },\n}\n"
