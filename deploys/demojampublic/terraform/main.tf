terraform {
  backend "s3" {
    bucket                      = "terraform"
    key                         = "demojampublic.tfstate"
    region                      = "auto"
    workspace_key_prefix        = "demojampublic"
    skip_credentials_validation = "true"
    skip_metadata_api_check     = "true"
