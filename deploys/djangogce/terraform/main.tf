# AUTOGENERATED by helicopyter

terraform {
  required_version = ">= 1.4"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
  }
}

provider "google" {
  project = var.project
  zone    = var.zone
}

variable "project" {
  type        = string
  description = "Existing Google Cloud project with billing and required APIs enabled."
}

variable "zone" {
  type        = string
  description = "Compute zone, for example us-central1-a."
}

variable "service_account" {
  type        = string
  description = "Existing VM service account email; grant access to the environment secret."
}

variable "repository" {
  type        = string
  description = "Public HTTPS Git repository containing the Django application."
}

variable "revision" {
  type        = string
  description = "Full immutable Git commit SHA; change on every deployment."
}

variable "environment_secret" {
  type        = string
  description = "projects/PROJECT/secrets/NAME/versions/NUMBER containing app.env."
}

variable "wsgi_module" {
  type        = string
  description = "Gunicorn application, for example config.wsgi:application."
}

variable "celery_app" {
  type        = string
  description = "Celery application, for example config."
}

data "google_compute_image" "ubuntu" {
  family  = "ubuntu-2404-lts-amd64"
  project = "ubuntu-os-cloud"
}

resource "google_compute_network" "django" {
  auto_create_subnetworks = true
  name                    = "django"
}

resource "google_compute_firewall" "iap" {
  name          = "django-iap-ssh"
  network       = google_compute_network.django.id
  source_ranges = ["35.235.240.0/20"]
  target_tags   = ["django"]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

resource "google_compute_firewall" "web" {
  name          = "django-http"
  network       = google_compute_network.django.id
  source_ranges = ["0.0.0.0/0"]
  target_tags   = ["django"]
  allow {
    protocol = "tcp"
    ports    = ["80"]
  }
}

resource "google_compute_address" "django" {
  name   = "django"
  region = join("-", slice(split("-", var.zone), 0, 2))
}

resource "google_compute_instance" "django" {
  name         = "django"
  machine_type = "e2-standard-2"
  tags         = ["django"]
  boot_disk {
    auto_delete = false
    initialize_params {
      image = data.google_compute_image.ubuntu.self_link
      size  = 30
      type  = "pd-balanced"
    }
  }
  network_interface {
    network = google_compute_network.django.id
    access_config {
      nat_ip = google_compute_address.django.address
    }
  }
  service_account {
    email  = var.service_account
    scopes = ["https://www.googleapis.com/auth/cloud-platform"]
  }
  metadata = {
    enable-oslogin         = "TRUE"
    app-repository         = var.repository
    app-revision           = var.revision
    app-environment-secret = var.environment_secret
    app-wsgi-module        = var.wsgi_module
    app-celery-app         = var.celery_app
    user-data              = "#cloud-config\npackage_update: true\npackages:\n  # DEBS from .biobuddies/includes.bash, plus build and runtime dependencies\n  - bash\n  - ca-certificates\n  - bind9-host\n  - curl\n  - file\n  - fping\n  - git\n  - less\n  - procps\n  - tmux\n  - tree\n  - build-essential\n  - libpq-dev\n  - nginx\n  - postgresql\n  - python3\n  - redis-server\nusers:\n  - default\n  - name: django\n    homedir: /opt/django\n    shell: /bin/bash\n    lock_passwd: true\nwrite_files:\n  - path: /usr/local/sbin/django-deploy\n    permissions: '0755'\n    content: |\n      #!/usr/bin/env bash\n      set -o errexit -o nounset -o pipefail\n      exec 9>/run/django-deploy.lock\n      flock 9\n      metadata() {\n          curl --fail --silent --show-error --retry 5 -H 'Metadata-Flavor: Google' \\\n              \"http://metadata.google.internal/computeMetadata/v1/instance/attributes/$1\"\n      }\n      systemctl stop django-web django-worker django-beat\n      install -d -m 0750 -o root -g django /etc/django\n      install -d -m 0755 -o django -g django /opt/django\n      metadata app-repository > /etc/django/repository\n      metadata app-revision > /etc/django/revision\n      revision=$(cat /etc/django/revision)\n      [[ $revision =~ ^[a-f0-9]{40}$ ]]\n      repository=$(cat /etc/django/repository)\n      [[ $repository == https://* ]]\n      secret=$(metadata app-environment-secret)\n      token=$(curl --fail --silent --show-error -H 'Metadata-Flavor: Google' \\\n          http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token \\\n          | python3 -c 'import json, sys; print(json.load(sys.stdin)[\"access_token\"])')\n      umask 077\n      curl --fail --silent --show-error --retry 5 -H \"Authorization: Bearer $token\" \\\n          \"https://secretmanager.googleapis.com/v1/$secret:access\" \\\n          | python3 -c 'import base64, json, sys; sys.stdout.buffer.write(\n          base64.b64decode(json.load(sys.stdin)[\"payload\"][\"data\"]))' > /etc/django/app.env.new\n      chown django:django /etc/django/app.env.new\n      mv /etc/django/app.env.new /etc/django/app.env\n      printf 'WSGI_MODULE=%s\\nCELERY_APP=%s\\n' \\\n          \"$(metadata app-wsgi-module)\" \"$(metadata app-celery-app)\" > /etc/django/process.env\n      runuser -u django -- env REPOSITORY=\"$repository\" REVISION=\"$revision\" bash -euo pipefail <<'BASH'\n      cd /opt/django\n      [[ -d code ]] || git clone \"$REPOSITORY\" code\n      cd code\n      git remote set-url origin \"$REPOSITORY\"\n      git fetch origin \"$REVISION\"\n      git checkout --detach \"$REVISION\"\n      export PATH=\"/opt/django/.local/bin:$PATH\"\n      export MISE_NO_HOOKS=1\n      if [[ ! -x /opt/django/.local/bin/mise ]]; then\n          curl --fail --location --silent --show-error https://mise.run | bash\n      fi\n      mise trust --all\n      mise install\n      mise exec -- uv venv --allow-existing\n      mise exec -- uv pip sync requirements.txt\n      [[ ! -f package-lock.json ]] || mise exec -- npm ci --no-audit --no-fund\n      set -o allexport\n      source /etc/django/app.env\n      set +o allexport\n      .venv/bin/python -m gunicorn --version\n      .venv/bin/python manage.py check --deploy --fail-level ERROR\n      .venv/bin/python manage.py migrate --noinput\n      .venv/bin/python manage.py collectstatic --noinput\n      BASH\n      systemctl restart django-web django-worker django-beat\n  - path: /etc/systemd/system/django-deploy.service\n    content: |\n      [Unit]\n      Description=Install Django release and migrate before starting processes\n      Wants=network-online.target\n      After=network-online.target postgresql.service redis-server.service\n      Requires=postgresql.service redis-server.service\n      [Service]\n      Type=oneshot\n      ExecStart=/usr/local/sbin/django-deploy\n      TimeoutStartSec=1800\n      [Install]\n      WantedBy=multi-user.target\n  - path: /etc/systemd/system/django-web.service\n    content: |\n      [Service]\n      User=django\n      WorkingDirectory=/opt/django/code\n      EnvironmentFile=/etc/django/app.env\n      EnvironmentFile=/etc/django/process.env\n      ExecStart=/opt/django/code/.venv/bin/gunicorn $${WSGI_MODULE} --bind 127.0.0.1:8000\n      Restart=on-failure\n  - path: /etc/systemd/system/django-worker.service\n    content: |\n      [Service]\n      User=django\n      WorkingDirectory=/opt/django/code\n      EnvironmentFile=/etc/django/app.env\n      EnvironmentFile=/etc/django/process.env\n      ExecStart=/opt/django/code/.venv/bin/celery -A $${CELERY_APP} worker --loglevel=INFO\n      Restart=on-failure\n  - path: /etc/systemd/system/django-beat.service\n    content: |\n      [Service]\n      User=django\n      WorkingDirectory=/opt/django/code\n      EnvironmentFile=/etc/django/app.env\n      EnvironmentFile=/etc/django/process.env\n      ExecStart=/opt/django/code/.venv/bin/celery -A $${CELERY_APP} beat --loglevel=INFO --schedule=/opt/django/celerybeat-schedule\n      Restart=on-failure\n  - path: /etc/nginx/sites-available/django\n    content: |\n      server {\n          listen 80 default_server;\n          server_name _;\n          location /static/ {\n              alias /opt/django/static/;\n          }\n          location / {\n              proxy_set_header Host $host;\n              proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n              proxy_pass http://127.0.0.1:8000;\n          }\n      }\nruncmd:\n  - [systemctl, enable, --now, postgresql, redis-server]\n  - [runuser, -u, postgres, --, createuser, django]\n  - [runuser, -u, postgres, --, createdb, --owner=django, django]\n  - [rm, -f, /etc/nginx/sites-enabled/default]\n  - [ln, -sf, /etc/nginx/sites-available/django, /etc/nginx/sites-enabled/django]\n  - [nginx, -t]\n  - [systemctl, restart, nginx]\n  - [systemctl, daemon-reload]\n  - [systemctl, enable, django-deploy]\n  - [systemctl, start, django-deploy]\n"
  }
  lifecycle {
    ignore_changes  = [boot_disk[0].initialize_params[0].image]
    prevent_destroy = true
  }
}

resource "terraform_data" "deploy" {
  triggers_replace = [google_compute_instance.django.id, sha256(jsonencode(google_compute_instance.django.metadata))]
  depends_on       = [google_compute_instance.django, google_compute_firewall.iap]
  provisioner "local-exec" {
    command = "bash ../redeploy.bash"
    environment = {
      PROJECT  = var.project
      ZONE     = var.zone
      INSTANCE = google_compute_instance.django.name
    }
  }
}

output "address" {
  value = google_compute_address.django.address
}
